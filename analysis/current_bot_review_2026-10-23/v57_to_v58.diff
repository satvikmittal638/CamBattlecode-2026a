-            const int k = static_cast<int>(ic[bc::item_type{static_cast<std::uint32_t>(i)}]);
-            if (k) n += k * ((i & 1) ? ((i / 6) == 1 ? 6 : 5) : 1);
-        }
-    } catch (const TurnAbort&) { throw; } catch (...) {}
-    return n;
-}
