+int Bot::nearestAltar(vec2 p) const {
+    int best = -1, bd = UNR;
+    for (std::size_t i = 0; i < altars.size(); ++i) {
+        int d = altarDistance(static_cast<int>(i), p);
+        if (d < bd) { bd = d; best = static_cast<int>(i); }
+    }
+    return best;
+}
